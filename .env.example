# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT=3000
JWT_SECRET=super_secret_jwt_key_for_dev

# Supabase server-side configuration
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Super Admin OTP email configuration
# The current Admin OTP implementation sends mail through Resend.
# Configure these on the server (local .env or your hosting provider).
RESEND_API_KEY="YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="verified-sender@your-domain.com"

# Legacy SMTP variables are kept here for reference only.
# They are not used by the current Admin OTP sender.
# SMTP_URL="smtps://SMTP_USERNAME:SMTP_PASSWORD@smtp.example.com"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-sender@gmail.com"
# SMTP_PASS="your-16-character-app-password"
# SMTP_FROM="meetdevani2003@gmail.com"
